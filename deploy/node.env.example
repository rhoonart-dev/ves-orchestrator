# /etc/ves/node.env — 노드마다 다른 것은 이 파일뿐 (bootstrap.sh 가 생성)
VES_HOME=/opt/ves
VES_NODE_ID=mm-01
VES_CAPABILITIES=generate,analyze,publish,network,scheduler
VES_MAX_CONCURRENCY=1

# 선택 — 유휴 폴링 간격(초). 기본 180(3분). 일감 있는 동안은 연속이라 체인 지연 없음.
# 빈 큐에서 검수 승인 → 처리 시작까지의 최대 대기가 이 값이다.
#VES_POLL_SEC=180
#VES_POLL_MAX_SEC=180
