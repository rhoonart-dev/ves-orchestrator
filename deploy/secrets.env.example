# /opt/ves/secrets/ves.env — chmod 600. sops/age 암호화로 배포, 평문 커밋 금지.
# 6대 동일 파일. (Phase 3: Edge Function 단명 토큰으로 축소 검토 — ARCHITECTURE §8-3)

# ── 컨트롤 플레인 (fdidiqd) ──
PIPELINE_DB_URL=postgresql://...   # Session pooler DSN (brain CLAUDE.md §1)
SUPABASE_URL=https://fdidiqdhcyctdbogxkdu.supabase.co
SUPABASE_SERVICE_KEY=...           # service_role — 워커 전용. 대시보드에 절대 금지(R12)

# ── 원천 DB (읽기전용) ──
LAEEBLY_DB_URL=postgresql://...

# ── 생성 ──
GEMINI_API_KEY=...
# 예비 키(0025) — 주 키가 결제 상한에 걸리면 워커가 자동으로 이쪽으로 넘긴다.
# ⚠ 반드시 **다른 결제 계정**의 키여야 한다. 429 'monthly spending cap' 은 키가 아니라
#   결제 계정에 걸려서, 같은 계정에서 새 키를 발급해도 똑같이 막힌다(8/12 실측).
# 어느 쪽을 쓸지는 DB(ops_config.gemini_key)가 정한다 — 6대가 다음 잡부터 함께 바뀐다.
GEMINI_API_KEY_FALLBACK=...

# ── 생성: KR 내레이션 TTS (ai-video E11 — 발주서 docs/prompts/e11-kr-tts-elevenlabs.md) ──
# 없으면 엔진이 edge-tts 로 폴백하고 로그에 명시한다. job_env 가 잡마다 다시 읽으므로
# 6대에 넣기만 하면 재기동 없이 다음 잡부터 적용된다(2026-08-18 실측 규율).
ELEVENLABS_API_KEY=...

# ── 조회: YouTube Data API 키 (성과 보완·채널 아이콘 — 읽기 전용, 발행과 무관) ──
# 없으면 perf_sync 의 성과 보완과 channels_sync 의 아이콘 갱신이 **조용히 생략**된다.
# 8/19 실측: 이 키가 없어 6개 채널 48편이 8일 동안 성과에서 통째로 비었다.
# brain(.env)의 REACT_APP_YOUTUBE_API_KEY 와 같은 키를 써도 된다. 스케줄러 노드에만 있으면 된다.
YOUTUBE_API_KEY=...

# ── 발행: OAuth 클라이언트 (gcp_project 별, channels.json 매핑) ──
YT_CLIENT_ID=...            YT_CLIENT_SECRET=...          # DEFAULT
YT_CLIENT_ID_P2=...         YT_CLIENT_SECRET_P2=...
YT_CLIENT_ID_SEAN=...       YT_CLIENT_SECRET_SEAN=...
YT_CLIENT_ID_VES01=...      YT_CLIENT_SECRET_VES01=...
YT_CLIENT_ID_VES03=...      YT_CLIENT_SECRET_VES03=...
YT_CLIENT_ID_VES04=...      YT_CLIENT_SECRET_VES04=...
YT_CLIENT_ID_CJENM=...      YT_CLIENT_SECRET_CJENM=...
YT_CLIENT_ID_JMLP=...       YT_CLIENT_SECRET_JMLP=...

# ── 발행: 채널별 refresh token (token_slug 20개 — 미발급분은 발행 하드실패 R10) ──
YT_REFRESH_TOKEN_JAEMISHOTS=...
YT_REFRESH_TOKEN_KIKKIK=...
# … channels.json 의 token_slug 전부 (get_youtube_token.py 로 발급)

# ── 사설 레포 접근 (자동 업데이트 git fetch 용 — 놓친부분⑤) ──
# 방법 A: https URL 에 PAT 포함해 bootstrap REPO_* 지정
# 방법 B: 노드별 deploy key + ssh URL

# ── 알림 ──
SLACK_WEBHOOK_URL=...
